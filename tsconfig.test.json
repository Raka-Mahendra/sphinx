{
  "extends": "./tsconfig.node.json",
  "include": [
    "src/main/**/*.test.ts",
    "src/main/**/*",
    "src/shared/**/*",
    "src/types/**/*",
    "src/sidecar/**/*"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "electron-vite/node"
    ]
  },
  "exclude": [
    "src/main/index.ts"
  ]
}
