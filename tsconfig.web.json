{
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/big-picture/src/**/*",
    "src/big-picture/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/locales/index.ts",
    "src/shared/**/*",
    "src/stories/**/*",
    "src/types/**/*",
    ".storybook/**/*",
    "src/tauri-bridge/**/*",
    "src/preload/index.ts"
  ],
  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "node",
    "sourceMap": false,
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "composite": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "electron": ["src/tauri-bridge/electron.ts"],
      "@renderer/*": ["src/renderer/src/*"],
      "@types": ["src/types/index.ts"],
      "@locales": ["src/locales/index.ts"],
      "@shared": ["src/shared/index.ts"],
      "@preload/*": ["src/preload/*"],
      "@tauri-bridge/*": ["src/tauri-bridge/*"],
      "@tauri-bridge": ["src/tauri-bridge/index.ts"]
    }
  }
}
